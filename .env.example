# Copy to .env.local (gitignored) only if you need to change a default.
#
# Where `npm run dev` forwards /api. The default is the Node API from the
# sibling Backend/ directory on its own default port.
# VITE_API_PROXY_TARGET=http://localhost:37411

# Where the built app sends its requests. Unset means same-origin `/api`,
# which is what the dev proxy provides and what a deployment behind one
# reverse proxy provides too. Set it only when the API really is on another
# origin — and then that origin has to be on the backend's
# TOOLTRACK_ALLOWED_ORIGINS, or the browser will drop the session cookie.
# VITE_API_BASE_URL=https://api.example.com/api
