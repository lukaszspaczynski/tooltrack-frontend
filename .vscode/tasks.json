{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "npm",
      "script": "format",
      "problemMatcher": []
    },
    {
      // Vite on http://localhost:5173, proxying /api to the Node API. The
      // pattern lets VS Code know the server is ready, so a compound launch
      // does not attach Chrome to a port nothing is listening on yet.
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      // Rewrites src/api/schema.d.ts from ../Backend/docs/openapi.json, which
      // is the file `api/contract.ts` checks our own types against. Nothing
      // runs it for you and nothing can: the input lives in the other repo,
      // and it changes when somebody there runs `openapi: build`.
      //
      // So the pair is: that task there, this one here, then typecheck says
      // which of our types the API no longer agrees with.
      "label": "api: types",
      "type": "npm",
      "script": "api:types",
      "problemMatcher": []
    },
    {
      // The same question without the write: is the committed schema.d.ts
      // still what the backend's document generates. A diff, so it fails
      // loudly rather than quietly bringing the file up to date.
      "label": "api: types check",
      "type": "npm",
      "script": "api:types:check",
      "problemMatcher": []
    },
    {
      // The contract as a page, served by the API this client talks to. Worth
      // a click from here rather than from the backend window: the question
      // "what does this endpoint answer" is asked while writing a screen.
      "label": "open: swagger in browser",
      "type": "shell",
      "command": "open http://localhost:37411/api/docs",
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },
    {
      "label": "open: app in browser",
      "type": "shell",
      "command": "open http://localhost:5173",
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    }
  ]
}
